# Copy this file to `.env.local` for local dev, or set these in the Vercel
# project's Environment Variables UI for production.
#
# When BOTH variables are set, the app reads/writes through Supabase and
# every browser sees realtime updates. When EITHER is missing, the app
# falls back to per-browser localStorage (the original single-user mode).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
